# Base URL the browser uses for API calls. Leave empty to call same-origin `/api/...`
# (the Vite dev server proxies it to VITE_API_PROXY_TARGET). Set it to the backend origin,
# e.g. http://localhost:8080, when the backend serves CORS headers for this app.
VITE_API_BASE_URL=

# Dev-only: where the Vite dev server proxies `/api` requests (the Spring Boot dev port).
VITE_API_PROXY_TARGET=http://localhost:8080
