# syntax=docker/dockerfile:1.7
ARG NODE_IMAGE=node:24.22.2-alpine3.24@sha256:a34ab6d7f6f4813f4d0c5469d74685604b962fbdbf5793a7bc7b4998ecb867c8
FROM ${NODE_IMAGE} AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN --mount=type=cache,target=/root/.npm npm ci
COPY . .
ARG VITE_API_BASE_URL=
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}
# Hanko public API for this image's environment (embedded in the bundle, not a secret).
ARG VITE_HANKO_API_URL=https://identity.pocket-doc.app
ENV VITE_HANKO_API_URL=${VITE_HANKO_API_URL}
RUN npm run build

FROM nginx/nginx-unprivileged:1.31.9-alpine3.24@sha256:60214a103e6f38e953ff957f34b1f2e97a9db801ab2df3821da955d0fe6cadd6 AS runtime
ARG VITE_HANKO_API_URL=https://identity.pocket-doc.app
USER root
RUN apk upgrade --no-cache \
    && apk add --no-cache --upgrade 'libxml2>=2.13.9-r3' \
    && sed -i '1i load_module modules/ngx_http_js_module.so;' /etc/nginx/nginx.conf
USER 101
ENV API_UPSTREAM=http://backend:8080 \
    CSP_HANKO_ORIGIN=${VITE_HANKO_API_URL} \
    CSP_HEADER_NAME=Content-Security-Policy-Report-Only \
    NGINX_ENVSUBST_FILTER='^(API_UPSTREAM|CSP_HANKO_ORIGIN|CSP_HEADER_NAME)$'
COPY nginx/default.conf.template /etc/nginx/templates/default.conf.template
COPY nginx/csp_nonce.js /etc/nginx/csp_nonce.js
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 CMD wget -q -O /dev/null http://127.0.0.1:8080/ || exit 1
